# ---------------------------------------------
# 목(mock) 데이터 서버 (json-server + db.json)
# 통계 화면이 /mock-api/MOLIT_MAP_INFO 를 호출하므로 필요함
# ---------------------------------------------
FROM node:22-alpine

WORKDIR /app

RUN npm install -g json-server@1.0.0-beta.15

COPY db.json ./db.json

EXPOSE 3002

# --host 0.0.0.0 이 없으면 컨테이너 내부에서만 접속 가능해서
# nginx(다른 컨테이너)가 호출하지 못함
CMD ["json-server", "db.json", "--port", "3002", "--host", "0.0.0.0"]
